{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oti:network:0.3",
  "$comment": "SPDX-License-Identifier: CC-BY-4.0",
  "type": "object",
  "required": [
    "id",
    "name",
    "coordinateSystem",
    "stops",
    "routes"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "coordinateSystem": {
      "enum": [
        "planar",
        "wgs84"
      ]
    },
    "stops": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "position"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "position": {
            "$ref": "#/$defs/point"
          },
          "accessible": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "parentId": {
            "type": "string"
          },
          "priority": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          }
        }
      },
      "maxItems": 5000
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "shortName",
          "paths"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "shortName": {
            "type": "string",
            "minLength": 1
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "paths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "stopIds"
              ],
              "properties": {
                "stopIds": {
                  "type": "array",
                  "minItems": 2,
                  "items": {
                    "type": "string"
                  }
                },
                "coordinates": {
                  "type": "array",
                  "minItems": 2,
                  "items": {
                    "$ref": "#/$defs/point"
                  }
                },
                "direction": {
                  "type": [
                    "string",
                    "number"
                  ]
                },
                "startTerminus": {
                  "type": "boolean"
                },
                "endTerminus": {
                  "type": "boolean"
                },
                "stopPositions": {
                  "type": "object",
                  "additionalProperties": {
                    "$ref": "#/$defs/point"
                  }
                }
              }
            }
          }
        }
      },
      "maxItems": 300
    },
    "metadata": {
      "type": "object"
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "targetId",
          "author",
          "reason",
          "kind"
        ],
        "properties": {
          "targetId": {
            "type": "string"
          },
          "author": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "label-side",
              "pin",
              "route-order"
            ]
          },
          "value": {}
        }
      }
    },
    "background": {
      "type": "array",
      "maxItems": 20000,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "coordinates"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "land",
              "water",
              "park",
              "urban",
              "building",
              "district",
              "street",
              "rail"
            ]
          },
          "geometry": {
            "enum": [
              "polygon",
              "line"
            ]
          },
          "coordinates": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "#/$defs/point"
              }
            }
          },
          "classification": {
            "type": "string",
            "maxLength": 40
          }
        }
      }
    }
  },
  "$defs": {
    "point": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number"
      }
    }
  }
}
